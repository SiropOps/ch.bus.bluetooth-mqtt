# Copy to bluetooth.env and edit locally. Docker env files do not expand shell variables.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=victron
MQTT_PASSWORD=CHANGE_ME
# MAC@32_HEX_DIGIT_KEY,MAC@32_HEX_DIGIT_KEY -- never commit real keys.
VICTRON_DEVICES=
# Optional MAC-to-name JSON mapping; use names from the existing MQTT topics.
VICTRON_NAMES={}
MQTT_VICTRON_BASE_TOPIC=van/victron
MQTT_TEMPERATURE_BASE_TOPIC=van/temperature
BLUETOOTH_ADAPTER=hci0
# TEMPERATURE_SENSORS defaults to the four existing BLE sensors.
# Use TEMPERATURE_SENSORS=[] to disable them, or a one-line JSON array to replace them.
